{
  "name": "projectlens",
  "displayName": "ProjectLens AI",
  "description": "Analyze your workspace for technologies, code quality, security risks, implementation progress and production readiness \u2014 with optional AI review via Groq, OpenAI, Gemini or Claude.",
  "version": "0.2.0",
  "publisher": "SandeepaMallawarachchi",
  "author": {
    "name": "Sandeepa Mallawarachchi"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e2a3a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sandeepaMallawarachchi/projectlens.git"
  },
  "bugs": {
    "url": "https://github.com/sandeepaMallawarachchi/projectlens/issues"
  },
  "homepage": "https://github.com/sandeepaMallawarachchi/projectlens#readme",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "code quality",
    "analysis",
    "ai review",
    "groq",
    "openai",
    "gemini",
    "claude"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces ProjectLens only runs its built-in in-memory analyzers. External scanners such as Gitleaks are disabled.",
      "restrictedConfigurations": [
        "projectlens.gitleaks.enabled",
        "projectlens.gitleaks.path"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectlens",
          "title": "ProjectLens",
          "icon": "media/projectlens.svg"
        }
      ]
    },
    "views": {
      "projectlens": [
        {
          "type": "webview",
          "id": "projectlens.sidebar",
          "name": "Project Health"
        }
      ]
    },
    "commands": [
      {
        "command": "projectlens.quickScan",
        "title": "Quick Scan",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.fullScan",
        "title": "Full Scan",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cancelScan",
        "title": "Cancel Scan",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.aiDeepReview",
        "title": "AI Deep Review",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.reviewCurrentFile",
        "title": "Review Current File with AI",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.openDashboard",
        "title": "Open Dashboard",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.openSettings",
        "title": "Open Settings",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.setApiKey",
        "title": "Set AI API Key",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.selectProvider",
        "title": "Select AI Provider",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.testConnection",
        "title": "Test AI Connection",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.removeApiKey",
        "title": "Remove AI API Key",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.selectModel",
        "title": "Select AI Model",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.exportJson",
        "title": "Export Report as JSON",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.exportMarkdown",
        "title": "Export Report as Markdown",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.clearScanHistory",
        "title": "Clear Scan History",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.createRequirementsFile",
        "title": "Create .projectlens.json Requirements File",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cloudOpen",
        "title": "Open ProjectLens Cloud",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cloudSignIn",
        "title": "Sign In to ProjectLens Cloud",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cloudSignOut",
        "title": "Sign Out of ProjectLens Cloud",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cloudLinkWorkspace",
        "title": "Link Workspace to Cloud Project",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cloudUpload",
        "title": "Upload Latest Scan to Cloud",
        "category": "ProjectLens"
      },
      {
        "command": "projectlens.cloudScan",
        "title": "Run Cloud Scan",
        "category": "ProjectLens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectlens.quickScan",
          "when": "view == projectlens.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "projectlens.openDashboard",
          "when": "view == projectlens.sidebar",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "projectlens.reviewCurrentFile",
          "when": "editorLangId =~ /(java|type)script/",
          "group": "z_projectlens"
        }
      ]
    },
    "configuration": {
      "title": "ProjectLens",
      "properties": {
        "projectlens.ai.provider": {
          "type": "string",
          "enum": [
            "groq",
            "openai",
            "gemini",
            "anthropic"
          ],
          "enumDescriptions": [
            "Groq Cloud",
            "OpenAI",
            "Google Gemini",
            "Anthropic Claude"
          ],
          "default": "groq",
          "description": "AI provider used for AI analysis. Each provider uses its own API key stored in SecretStorage."
        },
        "projectlens.ai.groq.model": {
          "type": "string",
          "default": "openai/gpt-oss-20b",
          "description": "Groq model."
        },
        "projectlens.ai.openai.model": {
          "type": "string",
          "default": "gpt-5-mini",
          "description": "OpenAI model."
        },
        "projectlens.ai.gemini.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Google Gemini model."
        },
        "projectlens.ai.anthropic.model": {
          "type": "string",
          "default": "claude-opus-5-5",
          "description": "Anthropic Claude model."
        },
        "projectlens.ai.maxContextTokens": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "maximum": 60000,
          "description": "Approximate upper bound of input tokens sent to the AI provider per request."
        },
        "projectlens.ai.maxOutputTokens": {
          "type": "number",
          "default": 2500,
          "minimum": 256,
          "maximum": 16000,
          "description": "Maximum tokens the model may generate per request. Claude and Gemini use at least 16000 / 8192 because thinking tokens count toward this limit."
        },
        "projectlens.ai.requestTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 300,
          "description": "Timeout for a single AI request."
        },
        "projectlens.ai.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 6,
          "description": "Retries for temporary AI errors (429, 5xx, network)."
        },
        "projectlens.ai.maxConcurrentRequests": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "Maximum number of concurrent AI requests."
        },
        "projectlens.ai.maxRequestsPerSession": {
          "type": "number",
          "default": 40,
          "minimum": 1,
          "maximum": 500,
          "description": "Hard limit on AI requests per VS Code session."
        },
        "projectlens.scan.maxFileSizeKb": {
          "type": "number",
          "default": 512,
          "minimum": 16,
          "description": "Files larger than this are skipped."
        },
        "projectlens.scan.maxFiles": {
          "type": "number",
          "default": 8000,
          "minimum": 100,
          "description": "Maximum number of files analyzed per workspace folder."
        },
        "projectlens.scan.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Skip files ignored by .gitignore."
        },
        "projectlens.scan.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional gitignore-style patterns to exclude from scans."
        },
        "projectlens.gitleaks.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run a locally installed Gitleaks executable during Full Scan (trusted workspaces only). ProjectLens never installs Gitleaks."
        },
        "projectlens.gitleaks.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Gitleaks executable. When empty, PATH is searched."
        },
        "projectlens.openDashboardOnSidebarOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the dashboard when the ProjectLens icon in the Activity Bar is clicked."
        },
        "projectlens.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish deterministic findings to the Problems panel."
        },
        "projectlens.diagnostics.minimumSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "default": "medium",
          "description": "Minimum severity of findings published to the Problems panel."
        },
        "projectlens.history.maxEntries": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "description": "Number of scan summaries retained in local history."
        },
        "projectlens.cloud.apiUrl": {
          "type": "string",
          "default": "https://projectlensai.vercel.app/api/v1",
          "description": "ProjectLens Cloud API base URL.",
          "scope": "application"
        },
        "projectlens.cloud.autoUpload": {
          "type": "boolean",
          "default": false,
          "description": "After each local scan, upload the results to the linked ProjectLens Cloud project (no source code is uploaded)."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && npm run build:extension && npm run build:webview",
    "build:extension": "node scripts/build-extension.mjs",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch:extension": "node scripts/build-extension.mjs --watch",
    "watch:webview": "vite build --config webview/vite.config.mts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && node scripts/build-integration-tests.mjs && vscode-test",
    "package": "vsce package",
    "vscode:prepublish": "npm run build",
    "publish:marketplace": "vsce publish"
  },
  "dependencies": {
    "eslint": "^10.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@google/genai": "^3.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "groq-sdk": "^1.6.0",
    "ignore": "^7.0.14",
    "lucide-react": "^1.71.0",
    "mocha": "^12.0.3",
    "openai": "^7.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
