    "ignore": "^7.0.14",
    "next": "^16.4.6",
    "nodemailer": "10.2.1",
    "openai": "^7.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar": "^7.5.22",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
