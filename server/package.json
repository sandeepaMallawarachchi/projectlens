{
  "name": "projectlens-api",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectLens REST API: remote repository analysis, project overviews and AI insights.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "sync-engine": "node scripts/sync-engine.mjs",
    "predev": "npm run sync-engine",
