# ── Required ──────────────────────────────────────────────────────────────
# Platform operator key (long random string). Not for customers or integrations; requires X-ProjectLens-Org.
PROJECTLENS_ADMIN_KEY=
# Encrypts repository access tokens at rest. Generate: openssl rand -base64 32
PROJECTLENS_ENCRYPTION_KEY=

# ── Storage (Supabase) ─────────────────────────────────────────────────────
# Without these the API uses in-memory storage (data lost on restart; for local testing only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email sign-in (optional; GitHub sign-in works without it) ─────────────
RESEND_API_KEY=               # https://resend.com — requires a verified sending domain
EMAIL_FROM=ProjectLens <noreply@your-domain.com>

# ── AI ─────────────────────────────────────────────────────────────────────
# Organizations add their own AI keys from the VS Code extension (Cloud → Cloud AI keys).
# Server keys below are used ONLY if ALLOW_SERVER_AI_KEYS=true (e.g. a future paid plan).
ALLOW_SERVER_AI_KEYS=false
AI_PROVIDER=groq            # groq | openai | gemini | anthropic
AI_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Webhooks (optional) ───────────────────────────────────────────────────
PROJECTLENS_WEBHOOK_SECRET=   # signs callbacks: X-ProjectLens-Signature: sha256=<hmac>
WEBHOOK_ALLOWED_HOSTS=        # e.g. cloude-project-management.vercel.app

# ── Limits (optional) ──────────────────────────────────────────────────────
MAX_REPO_MB=200
MAX_FILE_KB=512
MAX_FILES=8000
SCAN_MIN_INTERVAL_SECONDS=60
SCAN_HISTORY_LIMIT=30
AI_MIN_INTERVAL_SECONDS=10
# Free-plan limits per organization
FREE_MAX_PROJECTS=25
FREE_MAX_SCANS_PER_DAY=100
FREE_MAX_UPLOADS_PER_DAY=200
FREE_MAX_AI_PER_DAY=50
GITLAB_ALLOWED_HOSTS=         # restrict self-hosted GitLab hosts
CORS_ALLOW_ORIGIN=            # only if browsers call the API directly (not recommended)
